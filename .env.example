# Faster Whisper Service Configuration

# Service port
PORT=8600

# Model settings
MODEL_SIZE=base          # tiny, base, small, medium, large-v2, large-v3, turbo
DEVICE=cuda              # cuda or cpu
COMPUTE_TYPE=float16     # float16, int8, int8_float16, float32

# GPU settings
GPU_IDLE_TIMEOUT=300     # Seconds before unloading model from GPU
NVIDIA_VISIBLE_DEVICES=0 # GPU ID (auto-selected by start.sh)
