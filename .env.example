# sitinfront configuration.
# Copy this file to .env for local use. Never commit .env (it is gitignored).
# Every variable is optional: when unset, the default written in its comment applies.
# Comments are on their own lines on purpose: `docker run --env-file` does not strip
# a comment written after a value.

# Web server port. Default: 8600
PORT=8600

# Whisper model the server uses when a request does not name one.
# Values: tiny, base, small, medium, large-v3, large-v3-turbo (needs a one-time download).
# Default: large-v3-turbo. The web UI sends its own choice (default: small).
MODEL_SIZE=small

# Compute device: cuda or cpu. Leave it unset to auto-detect (cuda if a GPU is found, else cpu).
# DEVICE=cpu

# Numeric precision: float16, int8, int8_float16, float32.
# Leave it unset for the recommended value per device (float16 on cuda, int8 on cpu).
# COMPUTE_TYPE=int8

# Seconds without requests before the model is unloaded to free memory. Default: 300
IDLE_TIMEOUT=300

# Seconds before an idle GPU model is offloaded (GPU manager). Default: 300
GPU_IDLE_TIMEOUT=300

# Keep the audio of each chunk next to its run artifact under runs/ (for debugging).
# Values: 0 or 1. Default: 0 (audio is deleted after transcription).
KEEP_AUDIO=0

# Which GPU to use on a machine with several. Only read when DEVICE is cuda. Default: 0
# NVIDIA_VISIBLE_DEVICES=0
# CUDA_VISIBLE_DEVICES=0
