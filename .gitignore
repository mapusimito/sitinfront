tests/fixtures/

# UX verification tooling deps
tools/ux/node_modules/

# UX baseline text is lecture content; keep local, commit only hashes
docs/ux-revamp/baseline/4min/
docs/ux-revamp/baseline/12min/
docs/ux-revamp/after-*/
# Working screenshots; the final set is committed by the last UX milestone
docs/ux-revamp/screens/

# Playwright MCP session cache (console logs and page snapshots, may contain private file names)
.playwright-mcp/

# Private research (trackers, plans, handoffs, audits, UX/UI material). Never commit.
private/

# Agent instructions (local only)
CLAUDE.md
